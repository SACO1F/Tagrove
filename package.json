{
  "name": "shiqian-desktop",
  "private": true,
  "version": "0.6.11",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs && node scripts/verify-reader-zoom.mjs && node scripts/check-localization.cjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "format": "prettier --write src scripts/*.cjs scripts/*.mjs *.json vite.config.ts && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:auto-tags": "cargo test --manifest-path src-tauri/tests/core-harness/Cargo.toml --lib"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.1",
    "motion": "^14.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
