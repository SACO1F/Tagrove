{
  "manifest_version": 3,
  "name": "拾签 · 网页采集",
  "version": "0.6.13",
  "description": "主动保存网页链接、选中文字与所选图片到本机拾签资料库。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "保存到拾签",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "options_page": "queue.html",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  }
}
